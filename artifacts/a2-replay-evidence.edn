 :evidence :durable-replay-semantics
 :result :pass
 :question "Can a session that observed or changed a project be resumed without re-observing or re-actuating that project?"

 :coordinate
 {:bb4t/commit "cc18ca7b4d6bcb9ff4d4303417d6d94a6616875a"
  :bbagent/commit "542eafe4541570e832b2ffc7823c44e9dd5c0a28"
  :bb4t/tag "bb4t-a2"
  :bbagent/tag "bbagent-a2"
  :builder "script/build-native"
  :builder/commit "542eafe4541570e832b2ffc7823c44e9dd5c0a28"
  :status :accepted-and-frozen
  :note "rebuilt from the accepted coordinates themselves; builder, source and evidence are one commit, so nothing here describes an earlier runtime plus later explanatory commits"}

 :invariant
 "Recovery reconstructs historical computational state without re-observing or re-actuating the external world."

 :implementation
 {:boundary "bb4t.kernel/invoke-authorized"
  :facade "bb4t.transcript, bb4t.context/evaluate arity 3"
  :classification "bb4t.catalog/effects, validated by bb4t.kernel/validate-catalog"
  :recording "bbagent.session/evaluate! and operator-evaluate!, journalled as :repl/operations on :repl/result"
  :recovery "bbagent.session/replay-context! over the plan bbagent.session/recovery-state builds"
  :lookup "bbagent.store/result-event, implemented by both backends"
  :storage "the journal's existing content-addressed externalization; no second persistence mechanism"}

 :receipt
 {:keys [:operation/id :capability/id :effects :args/digest :status :result
         :result/digest]
  :args/digest "bb4t.canonical/lenient-coordinate, total over any argument"
  :result/digest "bb4t.canonical/coordinate, taken before the journal stores the value, so a result the journal could not keep intact fails closed rather than reconstructing wrong"}

 :fail-closed
 {:operation-mismatch "replay called a different operation"
  :args-mismatch "replay called the same operation with different arguments"
  :exhausted "replay called more operations than were recorded"
  :unconsumed "replay called fewer operations than were recorded"
  :result-integrity "a recorded result did not survive storage intact"
  :opaque-result "a recorded result was not inert enough to reconstruct"
  :actuation-without-transcript "a form recorded before receipts existed would change the project again"
  :ordering "the transcript is checked before the status, because a divergence can reach the recorded status by a different route"}

 :compatibility
 {:sessions-with-receipts "reconstructed exactly; :session/replay :exact? true"
  :sessions-without-receipts "observations re-execute against the live world and are counted; actuations fail closed"
  :claim "the resume event records :exact?, :forms, :reconstructed, :legacy and :reobserved, so a session never implies it reproduced history when it re-observed the project"}

