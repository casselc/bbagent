   :unstable
   {:status :finished
    :repl/attempts 13
    :used-edit? true :used-run? true
    :run/executed 2
    :statuses [:project-changed :project-changed]
    :exits [nil nil]
    :distinct-input-coordinates 0
    :saw-project-changed? true
    :unanchored-runs-carry-no-coordinate? true
