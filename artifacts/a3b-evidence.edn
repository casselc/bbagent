 :superseded-by :a3c

 :nonclaims
 ["hiding excluded paths is not a privilege boundary; the machine is the boundary (closed by A3c)"
  "one manager version is approved because one has been measured, not because others are worse"
  "the overlay's lower layer is still live; A3b detects movement and does not prevent it"
  ":cwd is validated lexically, against the workspace it will be resolved in rather than against this tree"
  "the tool bundle is trusted, not verified; its digest says which bytes ran, not that they are benign"]

 :exclusions
 ["project/test" "project/build" "project/lint" "host tool vocabulary"
  "generic shell" "background processes" "dev-server lifecycle" "Git tooling"
  "network enablement" "package-installation policy" "memory" "skills"
  "subagents" "SCI Extension Manager"]}
