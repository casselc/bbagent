                         "bbagent.bb4t/require" "bbagent.bb4t/create"]
  :execute-profile/negative-count 20
  :projected-class-count 0
  :supplied-import-count 0}

 :replay
 {:new-logic-for-execution :none
  :mechanism "A2 operation transcripts, unchanged"
  :record :one-execution
  :replay :zero-further-executions
  :legacy :refused
  :legacy/refusal :actuation-without-transcript
  :instrument "bbagent.executor/invocation-count"
  :claim "a recovery that reconstructed a run and also performed it would leave the same result and a different count; the count is the only thing that separates them from outside"}

