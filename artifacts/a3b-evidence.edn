 :invariant
 "A model may run the project's own commands somewhere that is not this host, and cannot say anything about where that is, what it may reach, or what it is bounded by."

 :surface
 {:operation :project/run
  :sci/var "project/run"
  :arguments #{:argv :cwd :timeout-ms}
  :arguments/refused-not-ignored true
  :effect :project/execute
  :effect/kind :actuation
  :profile :agent/project-execute
  :profiles/frozen-unchanged [:agent/project-read :agent/project-survey
                              :agent/project-develop]
  :session/default-profile :agent/project-develop
  :limits {:project/run-max-timeout-ms 300000
           :project/run-max-stdout-bytes 1048576
           :project/run-max-stderr-bytes 1048576}}

 :seam
 {:layers ["SCI project/run" "bb4t :project/run capability"
           "bb4t.execution/ExecutionEnvironment"
           "bbagent.executor" "bbagent.worker" "smolvm"]
  :bb4t/knows-about-machines false
  :protocol/functions [:-describe :-execute]
  :resource :execution/environment
  :project-root/supplied-by :bb4t
  :rationale "bb4t is authoritative about which project every other operation acts on; execution is not the place to introduce a second answer"
  :fail-closed/at :context-creation
  :description/canonicalized-by :bb4t
  :description/host-paths 0}

 :host-policy
 {:not-model-arguments [:project-root :tools :environment :network :cpus
                        :memory :disk :machine-manager :mounts]
  :tool-bundle {:selection :host :digested? true}
  :ceilings {:worker/cpus 2 :worker/memory-mib 2048 :worker/timeout-ms 300000
             :worker/stdout-max-bytes 1048576 :worker/stderr-max-bytes 1048576}}

 :compatibility
 {:approved-versions #{"1.7.5"}
  :measured-by :a3a
  :unapproved :refused
  :override/available? true
  :override/recorded-as :host-override
  :claim "A3a measured one manager version; a version nobody has measured is refused rather than assumed equivalent"}

 :result-semantics
 {:statuses #{:completed :timeout :worker-failure :project-changed}
  :exit/present-only-when-exited true
  :timeout/has-exit? false
  :worker-failure/has-exit? false
  :project-changed {:process-outcome :demoted
                    :keys [:process/status :process/exit]
                    :input-coordinate :absent
                    :claim "nothing can pattern-match {:status :completed :exit 0} against a run that was never anchored to one project state"}
  :streams/rechecked-by-bb4t true}

 :visibility
 {:invariant "every project path visible to the workload is represented in the input coordinate, or is hidden from it"
  :mechanism {:workspace :overlay-whiteout :export :tmpfs-mask}
  :hidden-set :snapshot/excluded-paths
  :hidden-equals-excluded? true
  :nested-exclusions/handled? true
  :privilege-boundary? false
  :residual "a root workload inside the machine can `umount /input` and read the raw export; measured, gated, and claimed no more strongly than that"
  :superseded-by {:milestone :a3c
                  :what "the workload is no longer root and holds no capabilities, so the residual above is closed"
                  :note "this record is left as measured; it describes A3b and is not current behaviour"}
  :residual/gated-by "bbagent.worker-test/hiding-is-not-a-privilege-boundary-test"
  :stronger-property/would-need "a host-side filtered export (hardlink mirror); out of scope for A3b"}

 :authority
 {:claim "one new operation in one new profile, and nothing else"
  :execute-profile/grants #{:project/read :project/list :project/search
                            :project/stat :project/edit :project/run
                            :data/json-read :data/json-write}
  :execute-profile/is-develop-plus-run? true
  :default-profile/grants-run? false
  :negative-probe/count 58
  :negative-probe/previous 51
