 :review-fixes
 [{:defect "operator REPL evaluations were not journaled"
   :severity :correctness
   :cause "the operator REPL shares the model's bounded Context, so an operator definition a later journaled agent form depended on was never reconstructed on resume"
   :effect "resume could fail its status-equivalence check for a form that had recorded :ok"
   :fix "session/operator-evaluate! writes a durable :repl/request before evaluating and a :repl/result after, tagged :repl/origin :operator"
   :recovery "every durable REPL evaluation joins the replay program; only agent-origin evaluations reconstruct conversation turns"
   :compatibility "absent :repl/origin means :agent, so existing journals keep their meaning"
   :proven-by [:jvm-tests :native-tui-proof]}
  {:defect "the event pane's first read was not bounded at the storage layer"
   :severity :efficiency
   :cause "it read the complete session and trimmed, decoding and hydrating all history to show the newest events"
   :fix "store/recent-events; SQLite orders by seq descending with a limit and restores ascending order, the file backend trims its recovered cache"
   :scope "query capability only; durable semantics unchanged"}]

