{:paths ["src" "resources" "../bb4t/src" "../bb4t/resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
         org.babashka/sci {:git/url "https://github.com/borkdude/sci"
                           :git/sha "64163c4560e085ffdcf47951b406f62f753b7f4c"}
         cheshire/cheshire {:mvn/version "6.2.0"}
         org.babashka/http-client {:mvn/version "0.4.24"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
         org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
         ;; A1 TUI. Pinned to the versions bb4t compiles, not the ones
         ;; charm.clj requests, so development matches the native image.
         de.timokramer/charm.clj {:mvn/version "0.2.74"}
         org.clojure/core.async {:mvn/version "1.8.741"}
         org.jline/jline-terminal-ffm {:mvn/version "4.3.1"
                                       :exclusions [org.jline/jline-native]}
         org.jline/jline-terminal {:mvn/version "4.3.1"
                                   :exclusions [org.jline/jline-native]}
         org.jline/jline-reader {:mvn/version "4.3.1"}}
  :aliases
  {:test {:extra-paths ["test"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "bbagent.test-runner"]}}}
