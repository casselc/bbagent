#!/usr/bin/env bash

set -euo pipefail

BB4T_REPOSITORY=${BB4T_REPOSITORY:-https://github.com/casselc/babashka.git}
BBAGENT_REPOSITORY=${BBAGENT_REPOSITORY:-https://github.com/casselc/bbagent.git}
BB4T_COMMIT=${BB4T_COMMIT:-f438307280b7a01fd20e99f54cd82682ef15d12a}
BBAGENT_COMMIT=${BBAGENT_COMMIT:-45a63073ad02646bb99b2eb9d182060c7473b432}
SQLITE_SIDECAR_SHA256=f374da845a36d0a663521457f8e454413325e3b8247a15c2677426f4b15cf6ac
NEXT_JDBC_LICENSE_SHA256=9de5ceada4e5d000784566d4e8f95581984c7287e8b3d55e41639c9ec38ea2db
SCRIPT_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
BUILDER_COMMIT=$(git -C "$SCRIPT_ROOT" rev-parse HEAD)

if [[ ! "$BB4T_COMMIT" =~ ^[0-9a-f]{40}$ ]] || \
   [[ ! "$BBAGENT_COMMIT" =~ ^[0-9a-f]{40}$ ]]
then
  echo "BB4T_COMMIT and BBAGENT_COMMIT must be full lowercase 40-character SHAs" >&2
  exit 1
fi

BUILD_ROOT=${BBAGENT_BUILD_ROOT:-"${TMPDIR:-/tmp}/bbagent-s0a"}
if [ -e "$BUILD_ROOT" ]
then
  echo "Build root already exists: $BUILD_ROOT" >&2
  exit 1
fi
mkdir -p "$BUILD_ROOT"
DIST_DIR="$BUILD_ROOT/dist"
mkdir -p "$DIST_DIR"

git clone --filter=blob:none "$BB4T_REPOSITORY" "$BUILD_ROOT/bb4t"
git -C "$BUILD_ROOT/bb4t" checkout --detach "$BB4T_COMMIT"
git -C "$BUILD_ROOT/bb4t" submodule update --init --recursive --depth 1
BB4T_RESOLVED=$(git -C "$BUILD_ROOT/bb4t" rev-parse HEAD)

git clone --filter=blob:none "$BBAGENT_REPOSITORY" "$BUILD_ROOT/bbagent"
git -C "$BUILD_ROOT/bbagent" checkout --detach "$BBAGENT_COMMIT"
BBAGENT_RESOLVED=$(git -C "$BUILD_ROOT/bbagent" rev-parse HEAD)

if [ "$BB4T_RESOLVED" != "$BB4T_COMMIT" ] || [ "$BBAGENT_RESOLVED" != "$BBAGENT_COMMIT" ]
then
  echo "Resolved source coordinates do not match requested commits" >&2
  exit 1
fi

printf '%s\n' "$BB4T_RESOLVED" \
  > "$BUILD_ROOT/bb4t/resources/META-INF/babashka/bb4t-commit"
printf '%s\n' "$BBAGENT_RESOLVED" \
  > "$BUILD_ROOT/bbagent/resources/META-INF/bbagent/commit"

pushd "$BUILD_ROOT/bb4t" >/dev/null
BB4T_APPLICATION=bbagent BABASHKA_BINARY=bbagent script/uberjar
BB4T_APPLICATION=bbagent BABASHKA_BINARY=bbagent \
  script/compile "-Dorg.sqlite.lib.exportPath=$DIST_DIR"
popd >/dev/null

if [ ! -f "$DIST_DIR/libsqlitejdbc.so" ]
then
  echo "sqlite-jdbc did not export $DIST_DIR/libsqlitejdbc.so" >&2
  exit 1
fi

SIDECAR_SHA256=$(sha256sum "$DIST_DIR/libsqlitejdbc.so")
SIDECAR_SHA256=${SIDECAR_SHA256%% *}
if [ "$SIDECAR_SHA256" != "$SQLITE_SIDECAR_SHA256" ]
then
  echo "Exported sqlitejdbc sidecar does not match the pinned artifact" >&2
  exit 1
fi

install -m 0755 "$BUILD_ROOT/bb4t/bbagent" "$DIST_DIR/bbagent"
chmod 0755 "$DIST_DIR/libsqlitejdbc.so"
install -m 0644 "$BUILD_ROOT/bbagent/licenses/THIRD_PARTY_NOTICES.md" \
  "$DIST_DIR/THIRD_PARTY_NOTICES.md"
mkdir "$DIST_DIR/licenses"
unzip -p "$BUILD_ROOT/bb4t/target/babashka-1.13.219-standalone.jar" \
  META-INF/maven/org.xerial/sqlite-jdbc/LICENSE \
  > "$DIST_DIR/licenses/sqlite-jdbc-APACHE-2.0.txt"
unzip -p "$BUILD_ROOT/bb4t/target/babashka-1.13.219-standalone.jar" \
  META-INF/maven/org.xerial/sqlite-jdbc/LICENSE.zentus \
  > "$DIST_DIR/licenses/sqlite-jdbc-LICENSE.zentus"
curl -fsSL \
  https://raw.githubusercontent.com/seancorfield/next-jdbc/1b2e6cf0a8b042f8bcc826edf2e60e6a43365a72/LICENSE \
  > "$DIST_DIR/licenses/next.jdbc-EPL-2.0.txt"
NEXT_JDBC_LICENSE_ACTUAL=$(sha256sum "$DIST_DIR/licenses/next.jdbc-EPL-2.0.txt")
NEXT_JDBC_LICENSE_ACTUAL=${NEXT_JDBC_LICENSE_ACTUAL%% *}
if [ "$NEXT_JDBC_LICENSE_ACTUAL" != "$NEXT_JDBC_LICENSE_SHA256" ]
then
  echo "Pinned next.jdbc license content did not match its expected digest" >&2
  exit 1
fi

SMOKE_PROJECT="$BUILD_ROOT/smoke-project"
mkdir "$SMOKE_PROJECT"
printf 'S0a native SQLite authority fixture.\n' > "$SMOKE_PROJECT/README.md"
pushd "$SMOKE_PROJECT" >/dev/null
"$DIST_DIR/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/native-smoke.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/native-smoke.edn"
popd >/dev/null

RELOCATED="$BUILD_ROOT/relocated"
RUNTIME_TMP="$BUILD_ROOT/runtime-tmp"
mkdir "$RELOCATED" "$RUNTIME_TMP"
cp -a "$DIST_DIR/." "$RELOCATED/"
pushd "$SMOKE_PROJECT" >/dev/null
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/relocated-smoke.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/relocated-smoke.edn"
popd >/dev/null

shopt -s nullglob dotglob
runtime_tmp_entries=("$RUNTIME_TMP"/*)
shopt -u nullglob dotglob
if [ "${#runtime_tmp_entries[@]}" -ne 0 ]
then
  echo "SQLite extracted runtime files despite exported-sidecar mode" >&2
  exit 1
fi

mv "$RELOCATED/libsqlitejdbc.so" "$RELOCATED/libsqlitejdbc.so.held"
set +e
"$RELOCATED/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/missing-sidecar.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/missing-sidecar.out" \
  2> "$BUILD_ROOT/missing-sidecar.err"
MISSING_SIDECAR_EXIT=$?
set -e
mv "$RELOCATED/libsqlitejdbc.so.held" "$RELOCATED/libsqlitejdbc.so"
if [ "$MISSING_SIDECAR_EXIT" -eq 0 ] || [ -e "$BUILD_ROOT/missing-sidecar.db" ]
then
  echo "SQLite did not fail closed when its sidecar was absent" >&2
  exit 1
fi

{
  printf 'builder_commit=%s\n' "$BUILDER_COMMIT"
  printf 'bb4t_commit=%s\n' "$BB4T_COMMIT"
  printf 'bbagent_commit=%s\n' "$BBAGENT_COMMIT"
  printf 'sqlite_jdbc=org.xerial:sqlite-jdbc:3.53.2.1\n'
  printf 'next_jdbc=com.github.seancorfield:next.jdbc:1.3.1118\n'
  printf 'missing_sidecar_exit=%s\n' "$MISSING_SIDECAR_EXIT"
  sha256sum "$DIST_DIR/bbagent" "$DIST_DIR/libsqlitejdbc.so" \
    "$DIST_DIR/THIRD_PARTY_NOTICES.md" "$BUILD_ROOT/native-smoke.edn" \
    "$BUILD_ROOT/native-smoke.db" "$BUILD_ROOT/relocated-smoke.edn" \
    "$DIST_DIR/licenses/"*
  stat --format='%n %s bytes mode=%a' "$DIST_DIR/bbagent" \
    "$DIST_DIR/libsqlitejdbc.so" "$DIST_DIR/THIRD_PARTY_NOTICES.md" \
    "$DIST_DIR/licenses/"*
} > "$BUILD_ROOT/build-evidence.txt"

printf 'Built %s with %s from bb4t %s and bbagent %s\n' \
  "$DIST_DIR/bbagent" "$DIST_DIR/libsqlitejdbc.so" \
  "$BB4T_COMMIT" "$BBAGENT_COMMIT"
