#!/usr/bin/env bash

set -euo pipefail

BB4T_REPOSITORY=${BB4T_REPOSITORY:-https://github.com/casselc/babashka.git}
BBAGENT_REPOSITORY=${BBAGENT_REPOSITORY:-https://github.com/casselc/bbagent.git}
BB4T_COMMIT=${BB4T_COMMIT:-f438307280b7a01fd20e99f54cd82682ef15d12a}
BBAGENT_COMMIT=${BBAGENT_COMMIT:-1798dcd0e92a4b68facd8087ea863d8c8aacc3fa}
SQLITE_SIDECAR_SHA256=f374da845a36d0a663521457f8e454413325e3b8247a15c2677426f4b15cf6ac
SQLITE_JDBC_JAR_SHA256=f55e405ed96d5ffe629e05b7b51b059e1c7d64527c0cc90a972fbac06730ccc1
NEXT_JDBC_JAR_SHA256=387562bfa86dc1a5a402a06a04e8e3b353f82550d296d755e5e7ce4c124275c4
NEXT_JDBC_LICENSE_SHA256=9de5ceada4e5d000784566d4e8f95581984c7287e8b3d55e41639c9ec38ea2db
SCRIPT_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
BUILDER_COMMIT=$(git -C "$SCRIPT_ROOT" rev-parse HEAD)

if [[ ! "$BB4T_COMMIT" =~ ^[0-9a-f]{40}$ ]] || \
   [[ ! "$BBAGENT_COMMIT" =~ ^[0-9a-f]{40}$ ]]
then
  echo "BB4T_COMMIT and BBAGENT_COMMIT must be full lowercase 40-character SHAs" >&2
  exit 1
fi

BUILD_ROOT=${BBAGENT_BUILD_ROOT:-"${TMPDIR:-/tmp}/bbagent-s0b"}
if [ -e "$BUILD_ROOT" ]
then
  echo "Build root already exists: $BUILD_ROOT" >&2
  exit 1
fi
mkdir -p "$BUILD_ROOT"
DIST_DIR="$BUILD_ROOT/dist"
mkdir -p "$DIST_DIR"

git clone --filter=blob:none "$BB4T_REPOSITORY" "$BUILD_ROOT/bb4t"
git -C "$BUILD_ROOT/bb4t" checkout --detach "$BB4T_COMMIT"
git -C "$BUILD_ROOT/bb4t" submodule update --init --recursive --depth 1
BB4T_RESOLVED=$(git -C "$BUILD_ROOT/bb4t" rev-parse HEAD)

git clone --filter=blob:none "$BBAGENT_REPOSITORY" "$BUILD_ROOT/bbagent"
git -C "$BUILD_ROOT/bbagent" checkout --detach "$BBAGENT_COMMIT"
BBAGENT_RESOLVED=$(git -C "$BUILD_ROOT/bbagent" rev-parse HEAD)

if [ "$BB4T_RESOLVED" != "$BB4T_COMMIT" ] || [ "$BBAGENT_RESOLVED" != "$BBAGENT_COMMIT" ]
then
  echo "Resolved source coordinates do not match requested commits" >&2
  exit 1
fi

printf '%s\n' "$BB4T_RESOLVED" \
  > "$BUILD_ROOT/bb4t/resources/META-INF/babashka/bb4t-commit"
printf '%s\n' "$BBAGENT_RESOLVED" \
  > "$BUILD_ROOT/bbagent/resources/META-INF/bbagent/commit"

pushd "$BUILD_ROOT/bb4t" >/dev/null
BABASHKA_FEATURE_JDBC=false BABASHKA_FEATURE_SQLITE=false \
  BB4T_APPLICATION=bbagent BABASHKA_BINARY=bbagent script/uberjar
M2_REPOSITORY=${M2_REPOSITORY:-"$HOME/.m2/repository"}
SQLITE_JDBC_JAR="$M2_REPOSITORY/org/xerial/sqlite-jdbc/3.53.2.1/sqlite-jdbc-3.53.2.1.jar"
NEXT_JDBC_JAR="$M2_REPOSITORY/com/github/seancorfield/next.jdbc/1.3.1118/next.jdbc-1.3.1118.jar"
SQLITE_JDBC_JAR_ACTUAL=$(sha256sum "$SQLITE_JDBC_JAR")
SQLITE_JDBC_JAR_ACTUAL=${SQLITE_JDBC_JAR_ACTUAL%% *}
NEXT_JDBC_JAR_ACTUAL=$(sha256sum "$NEXT_JDBC_JAR")
NEXT_JDBC_JAR_ACTUAL=${NEXT_JDBC_JAR_ACTUAL%% *}
if [ "$SQLITE_JDBC_JAR_ACTUAL" != "$SQLITE_JDBC_JAR_SHA256" ] || \
   [ "$NEXT_JDBC_JAR_ACTUAL" != "$NEXT_JDBC_JAR_SHA256" ]
then
  echo "Pinned SQLite storage dependency JAR digest mismatch" >&2
  exit 1
fi
BABASHKA_FEATURE_JDBC=false BABASHKA_FEATURE_SQLITE=false \
  BB4T_APPLICATION=bbagent BABASHKA_BINARY=bbagent \
  script/compile "-Dorg.sqlite.lib.exportPath=$DIST_DIR"
popd >/dev/null

if [ ! -f "$DIST_DIR/libsqlitejdbc.so" ]
then
  echo "sqlite-jdbc did not export $DIST_DIR/libsqlitejdbc.so" >&2
  exit 1
fi

SIDECAR_SHA256=$(sha256sum "$DIST_DIR/libsqlitejdbc.so")
SIDECAR_SHA256=${SIDECAR_SHA256%% *}
if [ "$SIDECAR_SHA256" != "$SQLITE_SIDECAR_SHA256" ]
then
  echo "Exported sqlitejdbc sidecar does not match the pinned artifact" >&2
  exit 1
fi

install -m 0755 "$BUILD_ROOT/bb4t/bbagent" "$DIST_DIR/bbagent"
chmod 0755 "$DIST_DIR/libsqlitejdbc.so"
install -m 0644 "$BUILD_ROOT/bbagent/licenses/THIRD_PARTY_NOTICES.md" \
  "$DIST_DIR/THIRD_PARTY_NOTICES.md"
mkdir "$DIST_DIR/licenses"
unzip -p "$BUILD_ROOT/bb4t/target/babashka-1.13.219-standalone.jar" \
  META-INF/maven/org.xerial/sqlite-jdbc/LICENSE \
  > "$DIST_DIR/licenses/sqlite-jdbc-APACHE-2.0.txt"
unzip -p "$BUILD_ROOT/bb4t/target/babashka-1.13.219-standalone.jar" \
  META-INF/maven/org.xerial/sqlite-jdbc/LICENSE.zentus \
  > "$DIST_DIR/licenses/sqlite-jdbc-LICENSE.zentus"
curl -fsSL \
  https://raw.githubusercontent.com/seancorfield/next-jdbc/1b2e6cf0a8b042f8bcc826edf2e60e6a43365a72/LICENSE \
  > "$DIST_DIR/licenses/next.jdbc-EPL-2.0.txt"
NEXT_JDBC_LICENSE_ACTUAL=$(sha256sum "$DIST_DIR/licenses/next.jdbc-EPL-2.0.txt")
NEXT_JDBC_LICENSE_ACTUAL=${NEXT_JDBC_LICENSE_ACTUAL%% *}
if [ "$NEXT_JDBC_LICENSE_ACTUAL" != "$NEXT_JDBC_LICENSE_SHA256" ]
then
  echo "Pinned next.jdbc license content did not match its expected digest" >&2
  exit 1
fi

SMOKE_PROJECT="$BUILD_ROOT/smoke-project"
mkdir "$SMOKE_PROJECT"
printf 'S0a native SQLite authority fixture.\n' > "$SMOKE_PROJECT/README.md"
pushd "$SMOKE_PROJECT" >/dev/null
"$DIST_DIR/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/native-smoke.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/native-smoke.edn"
popd >/dev/null

RELOCATED="$BUILD_ROOT/relocated"
RUNTIME_TMP="$BUILD_ROOT/runtime-tmp"
mkdir "$RELOCATED" "$RUNTIME_TMP"
cp -a "$DIST_DIR/." "$RELOCATED/"
pushd "$SMOKE_PROJECT" >/dev/null
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/relocated-smoke.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/relocated-smoke.edn"
popd >/dev/null

S0B_PROJECT="$BUILD_ROOT/s0b-project"
S0B_STATE="$BUILD_ROOT/s0b-state"
S0B_AMBIGUOUS_STATE="$BUILD_ROOT/s0b-ambiguous-state"
S0B_TRANSACTION_STATE="$BUILD_ROOT/s0b-transaction-state"
mkdir "$S0B_PROJECT"
dd if=/dev/zero bs=70000 count=1 2>/dev/null | tr '\0' 'x' \
  > "$S0B_PROJECT/README.md"

TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0b-native-smoke \
  --phase create --state "$S0B_STATE" --session s0b-native-main \
  --project "$S0B_PROJECT" > "$BUILD_ROOT/s0b-create.edn"
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0b-native-smoke \
  --phase resume --state "$S0B_STATE" --session s0b-native-main \
  > "$BUILD_ROOT/s0b-resume.edn"
if ! grep -Fq ':object/required? true' "$BUILD_ROOT/s0b-create.edn" || \
   ! grep -Fq ':object/verified? true' "$BUILD_ROOT/s0b-create.edn" || \
   ! grep -Fq ':object/required? true' "$BUILD_ROOT/s0b-resume.edn" || \
   ! grep -Fq ':object/verified? true' "$BUILD_ROOT/s0b-resume.edn" || \
   ! grep -Fq ':value/data 70000' "$BUILD_ROOT/s0b-resume.edn"
then
  echo "S0b native CAS or replay evidence is incomplete" >&2
  exit 1
fi
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" sessions \
  --state "$S0B_STATE" --store sqlite > "$BUILD_ROOT/s0b-sessions.txt"
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" inspect s0b-native-main \
  --state "$S0B_STATE" --store sqlite > "$BUILD_ROOT/s0b-inspect.edn"
if ! grep -Fxq 's0b-native-main' "$BUILD_ROOT/s0b-sessions.txt"
then
  echo "S0b native session listing did not find the durable session" >&2
  exit 1
fi

set +e
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0b-native-smoke \
  --phase ambiguous-exit --state "$S0B_AMBIGUOUS_STATE" \
  --session s0b-native-ambiguous --project "$S0B_PROJECT" \
  > "$BUILD_ROOT/s0b-ambiguous-exit.edn" 2> "$BUILD_ROOT/s0b-ambiguous-exit.err"
S0B_AMBIGUOUS_EXIT=$?
set -e
if [ "$S0B_AMBIGUOUS_EXIT" -ne 73 ]
then
  echo "Ambiguous-effect native probe did not halt after durable intent" >&2
  exit 1
fi
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0b-native-smoke \
  --phase ambiguous-check --state "$S0B_AMBIGUOUS_STATE" \
  --session s0b-native-ambiguous > "$BUILD_ROOT/s0b-ambiguous-check.edn"
if ! grep -Fq ':recovery/status :failed-closed' "$BUILD_ROOT/s0b-ambiguous-check.edn" || \
   ! grep -Fq ':error/category :session-recovery-failure' \
      "$BUILD_ROOT/s0b-ambiguous-check.edn"
then
  echo "Ambiguous-effect native recovery did not fail closed" >&2
  exit 1
fi

set +e
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0b-native-smoke \
  --phase transaction-exit --state "$S0B_TRANSACTION_STATE" \
  --session s0b-native-transaction > "$BUILD_ROOT/s0b-transaction-exit.edn" \
  2> "$BUILD_ROOT/s0b-transaction-exit.err"
S0B_TRANSACTION_EXIT=$?
set -e
if [ "$S0B_TRANSACTION_EXIT" -ne 74 ]
then
  echo "Uncommitted-transaction native probe did not halt at its cut" >&2
  exit 1
fi
TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0b-native-smoke \
  --phase transaction-check --state "$S0B_TRANSACTION_STATE" \
  --session s0b-native-transaction > "$BUILD_ROOT/s0b-transaction-check.edn"
if ! grep -Fq ':event/count 1' "$BUILD_ROOT/s0b-transaction-check.edn" || \
   ! grep -Fq ':uncommitted-object/visible? false' \
      "$BUILD_ROOT/s0b-transaction-check.edn"
then
  echo "Uncommitted SQLite transaction became visible after hard exit" >&2
  exit 1
fi

TMPDIR="$RUNTIME_TMP" "$RELOCATED/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/s0b-authority.db" --project "$S0B_PROJECT" \
  > "$BUILD_ROOT/s0b-authority.edn"
if ! grep -Fq ':negative-probe/count 35' "$BUILD_ROOT/s0b-authority.edn" || \
   ! grep -Fq 'java.sql.Date' "$BUILD_ROOT/s0b-authority.edn" || \
   ! grep -Fq 'java.sql.Timestamp' "$BUILD_ROOT/s0b-authority.edn" || \
   ! grep -Fq 'bbagent.journal/file-store' "$BUILD_ROOT/s0b-authority.edn" || \
   ! grep -Fq ':forbidden-database/created? false' "$BUILD_ROOT/s0b-authority.edn"
then
  echo "S0b native authority evidence is incomplete" >&2
  exit 1
fi

# A1: the image now compiles a TUI.  Prove the model Context did not inherit
# terminal, JLine, charm, or TUI-adapter authority from that reachability.
for probe in 'org.jline.terminal.Terminal' \
             'org.jline.terminal.TerminalBuilder/terminal' \
             'org.jline.keymap.KeyMap' \
             'org.jline.reader.LineReader' \
             'charm.program/require' \
             'charm.terminal/create-terminal' \
             'bbagent.tui.app/require' \
             'bbagent.tui.command/start-worker!' \
             'bbagent.tui.state/require'
do
  if ! grep -Fq "$probe" "$BUILD_ROOT/s0b-authority.edn"
  then
    echo "A1 TUI authority negative missing: $probe" >&2
    exit 1
  fi
done
if ! grep -Fq ':projected-class-count 0' "$BUILD_ROOT/s0b-authority.edn" || \
   ! grep -Fq ':supplied-import-count 0' "$BUILD_ROOT/s0b-authority.edn"
then
  echo "A1 TUI reachability widened the model surface" >&2
  exit 1
fi

# A2: the project world and the vocabulary that composes over it must work in
# the native image, not only on the JVM.  These are positives; the negatives
# above still have to hold alongside them.
for a2 in ':project-list :ok' \
          ':project-search :ok' \
          ':project-stat :ok' \
          ':project-edit-anchored :ok' \
          ':project-edit-conflict-refused :ok' \
          ':composition :ok' \
          ':project/list' \
          ':project/search' \
          ':project/stat' \
          ':project/edit'
do
  if ! grep -Fq "$a2" "$BUILD_ROOT/s0b-authority.edn"
  then
    echo "A2 native evidence missing: $a2" >&2
    exit 1
  fi
done

shopt -s nullglob dotglob
runtime_tmp_entries=("$RUNTIME_TMP"/*)
shopt -u nullglob dotglob
if [ "${#runtime_tmp_entries[@]}" -ne 0 ]
then
  echo "SQLite extracted runtime files despite exported-sidecar mode" >&2
  exit 1
fi

mv "$RELOCATED/libsqlitejdbc.so" "$RELOCATED/libsqlitejdbc.so.held"
set +e
"$RELOCATED/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/missing-sidecar.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/missing-sidecar.out" \
  2> "$BUILD_ROOT/missing-sidecar.err"
MISSING_SIDECAR_EXIT=$?
set -e
mv "$RELOCATED/libsqlitejdbc.so.held" "$RELOCATED/libsqlitejdbc.so"
if [ "$MISSING_SIDECAR_EXIT" -eq 0 ] || \
   [ -e "$BUILD_ROOT/missing-sidecar.db" ] || \
   ! grep -Fq 'SQLite native sidecar is not a regular executable file' \
     "$BUILD_ROOT/missing-sidecar.err"
then
  echo "SQLite did not fail closed when its sidecar was absent" >&2
  exit 1
fi

cp "$RELOCATED/libsqlitejdbc.so" "$RELOCATED/libsqlitejdbc.so.verified"
printf '\0' >> "$RELOCATED/libsqlitejdbc.so"
set +e
"$RELOCATED/bbagent" s0a-sqlite-smoke \
  --database "$BUILD_ROOT/mismatched-sidecar.db" \
  --project "$SMOKE_PROJECT" > "$BUILD_ROOT/mismatched-sidecar.out" \
  2> "$BUILD_ROOT/mismatched-sidecar.err"
MISMATCHED_SIDECAR_EXIT=$?
set -e
mv "$RELOCATED/libsqlitejdbc.so.verified" "$RELOCATED/libsqlitejdbc.so"
if [ "$MISMATCHED_SIDECAR_EXIT" -eq 0 ] || \
   [ -e "$BUILD_ROOT/mismatched-sidecar.db" ] || \
   ! grep -Fq 'SQLite native sidecar SHA-256 mismatch' \
     "$BUILD_ROOT/mismatched-sidecar.err"
then
  echo "SQLite did not fail closed with an explicit sidecar digest diagnostic" >&2
  exit 1
fi

{
  printf 'builder_commit=%s\n' "$BUILDER_COMMIT"
  printf 'bb4t_commit=%s\n' "$BB4T_COMMIT"
  printf 'bbagent_commit=%s\n' "$BBAGENT_COMMIT"
  printf 'sqlite_jdbc=org.xerial:sqlite-jdbc:3.53.2.1\n'
  printf 'next_jdbc=com.github.seancorfield:next.jdbc:1.3.1118\n'
  printf 'sqlite_jdbc_jar_sha256=%s\n' "$SQLITE_JDBC_JAR_ACTUAL"
  printf 'next_jdbc_jar_sha256=%s\n' "$NEXT_JDBC_JAR_ACTUAL"
  printf 'missing_sidecar_exit=%s\n' "$MISSING_SIDECAR_EXIT"
  printf 'mismatched_sidecar_exit=%s\n' "$MISMATCHED_SIDECAR_EXIT"
  printf 's0b_ambiguous_exit=%s\n' "$S0B_AMBIGUOUS_EXIT"
  printf 's0b_transaction_exit=%s\n' "$S0B_TRANSACTION_EXIT"
  sha256sum "$DIST_DIR/bbagent" "$DIST_DIR/libsqlitejdbc.so" \
    "$DIST_DIR/THIRD_PARTY_NOTICES.md" "$BUILD_ROOT/native-smoke.edn" \
    "$BUILD_ROOT/native-smoke.db" "$BUILD_ROOT/relocated-smoke.edn" \
    "$BUILD_ROOT/s0b-create.edn" "$BUILD_ROOT/s0b-resume.edn" \
    "$BUILD_ROOT/s0b-sessions.txt" "$BUILD_ROOT/s0b-inspect.edn" \
    "$BUILD_ROOT/s0b-ambiguous-exit.edn" \
    "$BUILD_ROOT/s0b-ambiguous-check.edn" \
    "$BUILD_ROOT/s0b-transaction-exit.edn" \
    "$BUILD_ROOT/s0b-transaction-check.edn" \
    "$BUILD_ROOT/s0b-authority.edn" "$S0B_STATE/bbagent.sqlite3" \
    "$BUILD_ROOT/missing-sidecar.out" "$BUILD_ROOT/missing-sidecar.err" \
    "$BUILD_ROOT/mismatched-sidecar.out" \
    "$BUILD_ROOT/mismatched-sidecar.err" \
    "$DIST_DIR/licenses/"*
  stat --format='%n %s bytes mode=%a' "$DIST_DIR/bbagent" \
    "$DIST_DIR/libsqlitejdbc.so" "$DIST_DIR/THIRD_PARTY_NOTICES.md" \
    "$DIST_DIR/licenses/"* "$S0B_STATE/bbagent.sqlite3" \
    "$BUILD_ROOT/s0b-inspect.edn"
  du --bytes --summarize "$DIST_DIR"
  wc -l "$BUILD_ROOT/s0b-inspect.edn"
} > "$BUILD_ROOT/build-evidence.txt"

printf 'Built %s with %s from bb4t %s and bbagent %s\n' \
  "$DIST_DIR/bbagent" "$DIST_DIR/libsqlitejdbc.so" \
  "$BB4T_COMMIT" "$BBAGENT_COMMIT"
